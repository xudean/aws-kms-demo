# Parent-side AWS configuration. The default credential chain is used for S3
# and, unless KMS_PRIMARY_* is set, for the primary KMS key.
AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=your_primary_or_s3_access_key_id
# AWS_SECRET_ACCESS_KEY=your_primary_or_s3_secret_access_key
# AWS_SESSION_TOKEN=your_primary_or_s3_session_token

# Two full KMS key ARNs are required. Different accounts are strongly
# recommended; same-account keys are allowed but emit a prominent warning.
# Both keys must currently be in the same region so one enclave KMS proxy can
# serve them. Region and account ID are derived from the ARNs.
KMS_PRIMARY_KEY_ARN=arn:aws:kms:ap-southeast-1:111122223333:key/00000000-0000-0000-0000-000000000000
KMS_BACKUP_KEY_ARN=arn:aws:kms:ap-southeast-1:444455556666:key/11111111-1111-1111-1111-111111111111

# Optional explicit primary credentials. Omit these to use the default chain.
# KMS_PRIMARY_ACCESS_KEY_ID=your_primary_access_key_id
# KMS_PRIMARY_SECRET_ACCESS_KEY=your_primary_secret_access_key
# KMS_PRIMARY_SESSION_TOKEN=your_primary_session_token

# Optional in serve mode: if these are absent or unusable, primary KMS can
# still restore the key. Required when running the one-time init-key command.
# KMS_BACKUP_ACCESS_KEY_ID=your_backup_access_key_id
# KMS_BACKUP_SECRET_ACCESS_KEY=your_backup_secret_access_key
# KMS_BACKUP_SESSION_TOKEN=your_backup_session_token

S3_BUCKET=your-s3-bucket
S3_PREFIX=kms-keypair

# Choose one of KMS_KEY_SPEC or KMS_NUMBER_OF_BYTES.
KMS_KEY_SPEC=AES_256
# KMS_NUMBER_OF_BYTES=32

# Optional KMS request settings.
# KMS_ENCRYPTION_CONTEXT=app=demo,env=dev
# KMS_GRANT_TOKENS=token1,token2
# KMS_DRY_RUN=false

# Broker-delivered mode. Keep serve for normal operation. The local
# decrypt-server-tee init-key argument overrides this value. The enclave init
# script starts a temporary broker with init-key without changing this file.
DECRYPT_SERVER_TEE_MODE=serve

# false: direct Rust AWS SDK calls for local development.
# true: Nitro attestation through the parent-side KMS vsock-proxy.
RUNNING_IN_ENCLAVE=false

ENCLAVE_BROKER_LISTEN_ENDPOINT=tcp:127.0.0.1:7001
ENCLAVE_BROKER_ENDPOINT=tcp:127.0.0.1:7001
# ENCLAVE_BROKER_ALLOWED_CID=16

ENCLAVE_RPC_LISTEN_ENDPOINT=tcp:127.0.0.1:7003
ENCLAVE_RPC_ENDPOINT=tcp:127.0.0.1:7003

NITRO_PARENT_CID=3
NITRO_KMS_PROXY_PORT=8000
