# -----------------------------------------------------------------------------
# AWS SDK configuration
# Used by: parent-instance, s3-proxy, and decrypt-server-tee in local KMS mode.
# In production, prefer the EC2 instance profile instead of static credentials.
# -----------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=your_session_token

# -----------------------------------------------------------------------------
# Business/key-material settings
# Loaded by: parent-instance and s3-proxy.
# Consumed by: decrypt-server-tee after parent-instance sends them over RPC.
# -----------------------------------------------------------------------------
KMS_KEY_ID=arn:aws:kms:ap-southeast-1:123456789012:key/00000000-0000-0000-0000-000000000000
S3_BUCKET=your-s3-bucket
# S3_KEY=kms-keypair.json

# Choose one of KMS_KEY_SPEC or KMS_NUMBER_OF_BYTES.
KMS_KEY_SPEC=AES_256
# KMS_NUMBER_OF_BYTES=32

# Optional KMS request settings, sent to decrypt-server-tee by parent-instance.
# KMS_ENCRYPTION_CONTEXT=app=demo,env=dev
# KMS_GRANT_TOKENS=token1,token2
# KMS_DRY_RUN=false

# -----------------------------------------------------------------------------
# decrypt-server-tee KMS mode
# Used by: decrypt-server-tee only.
# -----------------------------------------------------------------------------
# false: call KMS directly with the Rust AWS SDK (local development).
# true: use Nitro attestation and the parent-side official KMS vsock-proxy.
RUNNING_IN_ENCLAVE=false

# -----------------------------------------------------------------------------
# Parent configuration/credential RPC
# Listener: parent-instance. Client: decrypt-server-tee.
# -----------------------------------------------------------------------------
PARENT_CONFIG_ENDPOINT=tcp:127.0.0.1:7001

# Used by: parent-instance only when it listens on Vsock.
# PARENT_ALLOWED_ENCLAVE_CID=16

# -----------------------------------------------------------------------------
# S3 RPC
# Listener: s3-proxy. Client: decrypt-server-tee.
# -----------------------------------------------------------------------------
S3_PROXY_ENDPOINT=tcp:127.0.0.1:7002

# -----------------------------------------------------------------------------
# Enclave application RPC
# Listener setting: decrypt-server-tee. Client setting: parent-instance hello.
# -----------------------------------------------------------------------------
ENCLAVE_RPC_LISTEN_ENDPOINT=tcp:127.0.0.1:7003
ENCLAVE_RPC_ENDPOINT=tcp:127.0.0.1:7003

# -----------------------------------------------------------------------------
# Nitro KMS transport
# Used by: decrypt-server-tee only when RUNNING_IN_ENCLAVE=true.
# The official vsock-proxy runs on the parent at CID 3, port 8000.
# -----------------------------------------------------------------------------
NITRO_PARENT_CID=3
NITRO_KMS_PROXY_PORT=8000
