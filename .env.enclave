# Runtime configuration embedded in the EIF and loaded by decrypt-server-tee.
# Used by: decrypt-server-tee only.
# Do not put AWS credentials, KMS/S3 business settings, or secrets in this file;
# those are supplied at runtime by enclave-broker.

RUNNING_IN_ENCLAVE=true

# Parent broker RPC for configuration, credentials, and S3 key material.
# Parent CID is always 3 from inside a Nitro Enclave.
ENCLAVE_BROKER_ENDPOINT=vsock:3:7001

# Nitro KMS transport used by decrypt-server-tee. The listener is Nitro CLI's
# official KMS vsock-proxy on the parent instance.
NITRO_PARENT_CID=3
NITRO_KMS_PROXY_PORT=8000

# Hello RPC listener used by decrypt-server-tee. enclave-broker hello connects
# to it using the enclave CID assigned by nitro-cli run-enclave, for example
# vsock:16:7003 from the parent.
ENCLAVE_RPC_LISTEN_ENDPOINT=vsock:0:7003
